# Apollo master API key — https://app.apollo.io/#/settings/integrations/api
# Enrichment endpoints require a MASTER key, not a standard one.
APOLLO_API_KEY=

# Public HTTPS URL that forwards to this server, e.g. a cloudflared tunnel.
# Required ONLY for mobile numbers: Apollo delivers phones asynchronously
# to a webhook and refuses reveal_phone_number without one.
# APOLLO_WEBHOOK_BASE=https://your-tunnel.trycloudflare.com
