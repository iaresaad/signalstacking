# OS
.DS_Store

# Local Claude settings (machine-specific permission allowlist)
.claude/settings.local.json

# Private: your real seller positioning (keep seller-context.example.md only)
.claude/signal-stacking/seller-context.md

# Private: real Trumpet product/CRM usage data (keep the .example template only)
.claude/signal-stacking/trumpet-usage-data.md

# Private: your real target-account list (keep accounts.example.csv only)
accounts/accounts.csv
accounts/accounts.txt

# Private: suppression list + any enriched/CRM exports (keep the .example only)
accounts/do-not-contact.csv
accounts/*enriched*.csv
accounts/clay-*.csv

# Private: real closed-lost CRM export (keep closed-lost.example.csv only)
accounts/closed-lost.csv

# Signal Scout run staging: request files, staged CSVs, headless run logs
runs/

# Generated prospect briefs — contain real people, contact info, and outreach targeting.
# Keep these out of the repo (especially if it ever goes public). Index is generated too.
research/

# Secrets: Apollo (and any other) API keys — never commit
.env

# Apollo enrichment cache: real emails and mobile numbers for real people
accounts/apollo-cache.json
